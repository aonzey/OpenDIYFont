<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF6F7FB">

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 主界面：只看字体列表 -->
        <ScrollView
            android:id="@+id/mainPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFF6F7FB"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="96dp">

                <TextView
                    style="@style/PageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/PageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/subtitle" />

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginBottom="8dp"
                            android:text="@string/font_list_title" />

                        <TextView
                            android:id="@+id/fontCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/font_count_placeholder"
                            android:textColor="#FF6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingTop="32dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="32dp"
                        android:text="@string/font_empty"
                        android:textColor="#FF9CA3AF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/fontContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 设置界面：设备、通道、模式、范围、恢复、日志 -->
        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFF6F7FB"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/PageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title" />

                <TextView
                    style="@style/PageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/settings_subtitle" />

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_title" />

                    <TextView
                        android:id="@+id/deviceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FF1F2937"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/vendorHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FF6B7280"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/capability_title" />

                        <Button
                            android:id="@+id/refreshButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/card_bg"
                            android:text="@string/refresh"
                            android:textColor="#FF4F46E5"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FF1F2937"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_title" />

                    <RadioGroup
                        android:id="@+id/modeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/modeAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/mode_auto_short"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/modeRoot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/mode_root_short"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/modeShizuku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/mode_shizuku_short"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/scopeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/scope_title" />

                        <Spinner
                            android:id="@+id/scopeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:entries="@array/scope_entries"
                            android:minHeight="44dp" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/rebootCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/reboot_after"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/strategy_title" />

                    <RadioGroup
                        android:id="@+id/strategyGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/strategyAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/strategy_auto"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/strategyTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/strategy_theme"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/strategyModule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/strategy_module"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/strategy_hint"
                        android:textColor="#FF6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/restoreButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/danger_button_bg"
                    android:text="@string/restore_default"
                    android:textColor="#FFBE185D"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/logs_title" />

                        <Button
                            android:id="@+id/clearLogsButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/card_bg"
                            android:text="@string/clear_logs"
                            android:textColor="#FF4F46E5"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/logText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FF374151"
                            android:textSize="11sp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_author"
                    android:textColor="#FF9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/disclaimer"
                    android:textColor="#FF9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/importFab"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/fab_bg"
            android:elevation="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/import_fab"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="8dp">

        <Button
            android:id="@+id/tabMain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/tab_button_bg"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/tab_main"
            android:textColor="@color/tab_text_selector"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/tab_button_bg"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/tab_settings"
            android:textColor="@color/tab_text_selector"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
